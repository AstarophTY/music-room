POSTGRES_DB=musicroom
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

SERVER_PORT=8080

# Backend URL used by the mobile app (baked in at build time, rebuild the app after changing it).
#   Android emulator : http://10.0.2.2:8080
#   iOS simulator    : http://localhost:8080
#   Real phone       : http://<your computer's local IP>:8080
BACKEND_URL=http://10.0.2.2:8080
DB_URL=jdbc:postgresql://localhost:5432/musicroom
DB_MAX_POOL_SIZE=10

JWT_SECRET=
JWT_ISSUER=music-room
JWT_AUDIENCE=music-room-app
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Google sign-in: the "Web application" OAuth client ID from Google Cloud Console.
# Used by the server (checks ID tokens) and baked into the app (rebuild after changing it).
GOOGLE_CLIENT_ID=
# Sign in with Apple: the app's bundle ID (iOS). Several IDs can be separated by commas.
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Spotify (required: users must connect Spotify to use the app). App from https://developer.spotify.com/dashboard
# Add this redirect URI in the Spotify app settings: http://127.0.0.1:8080/api/v1/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/v1/spotify/callback

# Music Room Premium (uploading songs), sold with Stripe. Leave STRIPE_SECRET_KEY empty to turn it off.
# STRIPE_PRICE_ID: a recurring price of the Premium product (https://dashboard.stripe.com/products).
# STRIPE_WEBHOOK_SECRET: from the webhook endpoint <server>/api/v1/billing/webhook (or `stripe listen` in development),
# with the events checkout.session.completed and customer.subscription.*. Without it, the status is read from Stripe.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=http://127.0.0.1:8080/api/v1/billing/return
# true: Stripe Tax adds the VAT at checkout. Turn on Stripe Tax, set the product tax code and add the
# French registration in the Dashboard first (https://dashboard.stripe.com/tax).
STRIPE_AUTOMATIC_TAX=false

# Leave SMTP_HOST empty in development: emails are written to the server logs (make logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

PGADMIN_EMAIL=admin@musicroom.local
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5050
