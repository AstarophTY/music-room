    <string name="terms_1_title">1. Purpose</string>
    <string name="terms_1_body">Music Room lets you create and join collaborative music sessions: vote for tracks, edit playlists together and share playback control with friends. These terms apply to every use of the app and its API.</string>
    <string name="terms_2_title">2. Your account</string>
    <string name="terms_2_body">You must give a valid email address and keep your password secret. You are responsible for what is done with your account. You can sign in with Google or Apple; the provider only shares your name, email and a user identifier with us.</string>
    <string name="terms_3_title">3. Acceptable use</string>
    <string name="terms_3_body">Do not spam votes, use automated tools to manipulate rankings, impersonate someone, or try to access other users’ data. We may suspend accounts that break these rules.</string>
    <string name="terms_4_title">4. Music content</string>
    <string name="terms_4_body">Tracks are streamed by third-party music services under their own terms. Music Room does not host music and does not grant any right on it.</string>
    <string name="terms_5_title">5. Personal data</string>
    <string name="terms_5_body">We store your email, display name, profile, friends, preferences and activity logs (platform, device model, app version) to run the service and keep it secure. Passwords are stored hashed. You can ask for your data to be exported or deleted at any time.</string>
    <string name="terms_6_title">6. Liability</string>
    <string name="terms_6_body">The service is provided as is, without guarantee of availability. We are not responsible for content shared by users.</string>
    <string name="terms_7_title">7. Changes</string>
    <string name="terms_7_body">We may update these terms. You will be asked to accept the new version before continuing to use the app.</string>
